class Solution(object):
    def findGCD(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        def gcd(a,b):
            while(b%a != 0):
                a,b = b%a,a
            
            return a

        a = min(nums)
        b = max(nums)
        return gcd(a,b)
