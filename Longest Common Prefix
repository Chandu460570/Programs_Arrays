class Solution(object):
    def longestCommonPrefix(self, strs):
        """
        :type strs: List[str]
        :rtype: str
        """

        if not strs:
            return "" 

        check=strs[0]
        encode = ""
        n=len(strs)
        for i in range(len(check)):
            for j in range(1,n):
                if i >= len(strs[j]) or check[i] != strs[j][i]:
                    return encode
            encode += check[i]
        return encode
