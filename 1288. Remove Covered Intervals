class Solution(object):
    def removeCoveredIntervals(self, intervals):
        """
        :type intervals: List[List[int]]
        :rtype: int
        """
        n = len(intervals)
        if n == 1:
            return 1
        
        intervals.sort(key=lambda x: x[0], reverse=True)

        count = n
        for i in range(n-1):
            for j in range(i+1,n):
                if intervals[i][1] <= intervals[j][1]:
                    count -= 1
                    break
        
        return count
