class Solution(object):
    def gcdSum(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        def gcd(a,b):
            if a == b:
                return b
            while a != 0:
                b,a = a,b%a
            
            return b

        n = len(nums)
        maxi = nums[0]
        prefix = [0]*n
        prefix[0] = nums[0]
        for i in range(1,n):
            maxi = max(maxi , nums[i])
            prefix[i] = gcd(nums[i],maxi)

        prefix.sort()
        total = 0
        i=0
        j=n-1
        while i<j:
            total += gcd(prefix[i],prefix[j])
            i+=1
            j-=1
        
        return total
